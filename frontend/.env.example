# Cesium ion access token — required for terrain + base imagery.
# Get one free at https://ion.cesium.com/tokens (restrict it to your domain).
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Only for production builds served on a different origin than the API.
# Leave blank in dev — the Vite proxy forwards /api to http://localhost:4000.
# VITE_API_BASE=https://your-api.example.org

# Base URL for the Coimbatore 3D property explorer's ODM/Scaniverse assets
# (frontend/public/models/coimbatore-demo/, ~127 MB — exterior OBJ/MTL/21
# textures + interior scan). Leave blank in dev: assets are served locally
# from /models/coimbatore-demo/ (unchanged). In production, set this to the
# Cloudflare R2 custom-domain URL — assets are then fetched from
# ${VITE_3D_ASSETS_BASE_URL}/coimbatore-demo/. See docs/10-deployment.md for
# the required R2 folder layout and CORS policy.
# VITE_3D_ASSETS_BASE_URL=https://assets.your-domain.example.org
