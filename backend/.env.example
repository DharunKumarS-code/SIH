# ---------------------------------------------------------------------------
# LAND STACK backend — environment
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ---------------------------------------------------------------------------

# HTTP port for the API server (spec default is 5000; 4000 used here because
# 5000 is commonly occupied on Windows).
PORT=4000

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string. LEAVE BLANK to run on the built-in seeded
# demo dataset (the app is fully functional without a database). Set it to
# switch to real persistence — the seed is mirrored into the cluster on boot.
MONGODB_URI=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Optional Python AI microservice (ai-service/). If unreachable, the backend
# serves clearly-labelled local mock inference instead, and Phase 3/4 uploads
# return INFERENCE_UNAVAILABLE (the rest of the app is unaffected).
AI_SERVICE_URL=http://localhost:8000

# Phase 3 — AI building-footprint extraction (all optional).
AI_MAX_UPLOAD_MB=12
AI_INFER_TIMEOUT_MS=30000
# The following are read by the Python ai-service (see ai-service/app/buildings/config.py):
#   AI_MODEL=classical            # or "unet" (needs torch + AI_UNET_WEIGHTS)
#   AI_UNET_WEIGHTS=
#   BUILDING_CONFIDENCE_THRESHOLD=0.50
#   AI_CONF_HIGH=0.80
#   AI_CONF_MED=0.55
#   AI_MAX_IMAGE_PX=4096

# Phase 4 — AI floor-plan & apartment/unit segmentation (all optional; reuses
# AI_SERVICE_URL / AI_MAX_UPLOAD_MB / AI_INFER_TIMEOUT_MS / AI_CONF_HIGH / AI_CONF_MED
# above). The following are read by the Python ai-service (see
# ai-service/app/floorplans/config.py):
#   FLOORPLAN_MODEL=classical     # or "semseg" (needs torch + FLOORPLAN_SEMSEG_WEIGHTS)
#   FLOORPLAN_SEMSEG_WEIGHTS=
#   FLOORPLAN_MAX_IMAGE_PX=3200
#   FLOORPLAN_WALL_DARK_THRESHOLD=0.45
#   FLOORPLAN_ROOM_MIN_AREA_PX=600
#   FLOORPLAN_ROOM_SEAL_PX=16
#   FLOORPLAN_DOOR_ADJACENCY_PX=6
# Dataset: CubiCasa5K (not bundled — see docs/16-ai-floor-plan-segmentation.md).

# Phase 5 — elevation / LiDAR / point-cloud / DEM / DSM (all optional; reuses
# AI_SERVICE_URL above). Point clouds are larger than the imagery uploads, so
# they get their own cap + longer timeout. The following are read by the
# Python ai-service (see ai-service/app/elevation/config.py):
#   ELEV_GRID_RESOLUTION_M=1.0
#   ELEV_FOOTPRINT_BUFFER_M=1.0
#   ELEV_GROUND_ANNULUS_BUFFER_M=3.0
#   ELEV_MIN_VALID_SAMPLES=4
#   ELEV_NEG_HEIGHT_ERROR_M=-2.0
#   ELEV_MAX_PLAUSIBLE_HEIGHT_M=250.0
#   ELEV_CONF_HIGH=0.75
#   ELEV_CONF_MED=0.45
# No official Chennai LiDAR/DEM/DSM dataset is bundled — see
# docs/17-lidar-dem-dsm-elevation.md.
AI_MAX_ELEVATION_UPLOAD_MB=60
AI_ELEVATION_TIMEOUT_MS=60000

# Optional: an OFFICIALLY SANCTIONED Government of India / Tamil Nadu ULPIN parcel
# endpoint (e.g. via an MoU / API key). LEAVE BLANK — no such public source is
# accessible today, so GovernmentDataProvider reports UNAVAILABLE and every parcel
# is served as DEMO data. Never point this at a scraper or a service that needs
# CAPTCHA/OTP/login to be bypassed. See docs/13-official-ulpin-data-investigation.md.
GOV_LAND_API_URL=

# Seed control
SEED_ON_BOOT=true
